# Modèle d'environnement DÉVELOPPEMENT (Supabase local Docker). Aucune valeur réelle ici.
# Copier vers `.env.local` (ignoré par git) et remplir avec les valeurs de `pnpm exec supabase status`.
# Validé au démarrage par packages/domain/src/env (zod) : l'application refuse de démarrer
# si une variable obligatoire manque. Le garde-fou `pnpm check:leaks` refuse tout secret
# dans une variable NEXT_PUBLIC_*.

APP_ENV=development

# --- Public (navigateur) : jamais de secret ici ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Serveur et worker uniquement ---
SUPABASE_URL=http://127.0.0.1:54321
# Clé secrète Supabase (équivalent service_role) : contourne la RLS, jamais dans le navigateur.
SUPABASE_SECRET_KEY=

# Optionnel jusqu'à J31 (ADR 008 encore « Proposed »)
RESEND_API_KEY=

# ADR 012 : false = aucune donnée client réelle envoyée à un modèle externe
AI_ALLOW_REAL_DATA=false
