# Modèle d'environnement PRODUCTION. Aucune valeur réelle ici.
# Les vraies valeurs vivent dans le gestionnaire de secrets de l'hébergeur (ADR 010), jamais dans git.
# Région des données et politique : décision Q5 / ADR 010 (encore ouverte).

APP_ENV=production

# --- Public (navigateur) : jamais de secret ici ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Serveur et worker uniquement ---
SUPABASE_URL=
SUPABASE_SECRET_KEY=

RESEND_API_KEY=

# ADR 012 : à ne passer à true qu'après documentation des CGU/rétention du fournisseur IA
AI_ALLOW_REAL_DATA=false
