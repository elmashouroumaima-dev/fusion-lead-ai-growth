# Modèle d'environnement PRODUCTION. Aucune valeur réelle ici.
# Les vraies valeurs vivent dans le gestionnaire de secrets de l'hébergeur (ADR 010), jamais dans git.
# Région des données et politique : décision Q5 / ADR 010 (encore ouverte).

APP_ENV=production

# --- Public (navigateur) : jamais de secret ici ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Serveur et worker uniquement ---
# URL publique du site : OBLIGATOIRE et en https (serveur uniquement, jamais NEXT_PUBLIC_*).
SITE_URL=https://app.example.invalid
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Nombre de reverse proxys de confiance devant l'application (adresse du visiteur dans x-forwarded-for, ADR 010). 0 = ignorer l'en-tête.
TRUSTED_PROXY_HOPS=1
# Cloudflare Turnstile (ADR 019) : clé secrète de la plateforme, serveur uniquement. TURNSTILE_ENFORCE=true l exige sur la capture publique.
TURNSTILE_SECRET_KEY=
TURNSTILE_ENFORCE=false

RESEND_API_KEY=

# ADR 012 : à ne passer à true qu'après documentation des CGU/rétention du fournisseur IA
AI_ALLOW_REAL_DATA=false
