# Modèle d'environnement STAGING (projet Supabase cloud « fusion-leap-staging »). Aucune valeur réelle ici.
# Les vraies valeurs vivent dans le gestionnaire de secrets de l'hébergeur (ADR 010), jamais dans git.
# Staging : données de test uniquement.

APP_ENV=staging

# --- Public (navigateur) : jamais de secret ici ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Serveur et worker uniquement ---
# URL publique du site : OBLIGATOIRE et en https (serveur uniquement, jamais NEXT_PUBLIC_*).
SITE_URL=https://staging.example.invalid
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Nombre de reverse proxys de confiance devant l'application (adresse du visiteur dans x-forwarded-for, ADR 010). 0 = ignorer l'en-tête.
TRUSTED_PROXY_HOPS=1

RESEND_API_KEY=

AI_ALLOW_REAL_DATA=false
