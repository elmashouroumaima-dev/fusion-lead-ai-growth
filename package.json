{
  "name": "fusion-leap-ai-growth",
  "version": "0.0.0",
  "private": true,
  "description": "Fusion Leap AI Growth — plateforme SaaS multi-tenant (monorepo pnpm + Turborepo)",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @fusion-leap/web dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:rls": "node scripts/not-yet.mjs test:rls J7",
    "test:e2e": "node scripts/not-yet.mjs test:e2e J15",
    "db:reset": "node scripts/not-yet.mjs db:reset J5",
    "db:migrate": "node scripts/not-yet.mjs db:migrate J6",
    "worker:dev": "pnpm --filter @fusion-leap/worker dev",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
