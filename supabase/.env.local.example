# Identifiants SMTP de la boîte de test Mailtrap (Email Testing > Inboxes > SMTP Settings).
# Copier ce fichier vers supabase/.env (ignoré par git) puis renseigner les deux valeurs.
# La CLI Supabase lit supabase/.env pour remplacer les env(...) de config.toml.
MAILTRAP_SMTP_USER=
MAILTRAP_SMTP_PASS=
